# Zephyros – Caddy Reverse Proxy
# - pihole.home -> local Pi-hole web UI (host port 8081)
# - all other .home domains -> Mnemosyne's Caddy via Tailscale (100.x.x.x)
#
# Port 80 belongs to Caddy (Pi-hole moved to 8081), so the automatic
# HTTP -> HTTPS redirect is active for every site.
# After relocation: replace 100.x.x.x with Mnemosyne's local IP (one place).

# -- Snippet: proxy to Mnemosyne ------------------------------------------
# Usage: import mnemosyne <hostname>
# Sets Host header and TLS SNI so Mnemosyne's Caddy picks the right site/cert.

(mnemosyne) {
    tls internal
    reverse_proxy https://100.x.x.x {
        header_up Host {args[0]}
        transport http {
            # Mnemosyne uses its own internal CA; tunnel is encrypted by Tailscale
            tls_insecure_skip_verify
            tls_server_name {args[0]}
            versions 1.1
        }
    }
}

# -- Pihole ---------------------------------------------------------------

pihole.home {
    tls internal
    redir / /admin/ 301
    reverse_proxy http://host.docker.internal:8081
}

# -- Git ------------------------------------------------------------------

git.home {
    import mnemosyne git.home
}

# -- Vault ----------------------------------------------------------------
vault.home {
    import mnemosyne vault.home
}

# -- Homepage -------------------------------------------------------------

homepage.home {
    import mnemosyne homepage.home
}

# -- Monitoring -----------------------------------------------------------

grafana.home {
    import mnemosyne grafana.home
}

prometheus.home {
    import mnemosyne prometheus.home
}

# -- Ghost ----------------------------------------------------------------

ghostwrite.home {
    import mnemosyne ghostwrite.home
}

ghostproxy.home {
    import mnemosyne ghostproxy.home
}

# -- Immich ---------------------------------------------------------------

immich.home {
    import mnemosyne immich.home
}

# -- Carousel -------------------------------------------------------------

carousel.home {
    import mnemosyne carousel.home
}
