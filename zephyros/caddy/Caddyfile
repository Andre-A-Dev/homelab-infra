{
    # Disable HTTP redirect – port 80 belongs to Pi-hole
    auto_https disable_redirects
}

# -- Pihole ---------------------------------------------------------------

pihole.home {
    tls internal
    redir / /admin/ 301
    reverse_proxy http://172.19.0.1:80
}

# -- Git ------------------------------------------------------------------

git.home {
    tls internal
    reverse_proxy https://git.home {
        header_up Host git.home
        transport http {
            tls_insecure_skip_verify
            versions 1.1
        }
    }
}

# -- Homepage --------------------------------------------------------------

homepage.home {
    tls internal
    reverse_proxy https://homepage.home {
        header_up Host homepage.home
        transport http {
            tls_insecure_skip_verify
            versions 1.1
        }
    }
}

