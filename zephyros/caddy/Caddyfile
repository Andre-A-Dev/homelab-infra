# -- Ghost -----------------------------------------------------------------

ghostwrite.home {
    tls internal
    reverse_proxy https://ghostwrite.home {
        header_up Host ghostwrite.home
        transport http {
            tls_insecure_skip_verify
                        versions 1.1
        }
    }
}

ghostproxy.home {
    tls internal
    reverse_proxy https://ghostproxy.home {
        header_up Host ghostproxy.home
        transport http {
            tls_insecure_skip_verify
                        versions 1.1
        }
    }
}

# -- Immich ---------------------------------------------------------------

immich.home {
    tls internal

    reverse_proxy https://100.x.x.x {
        header_up Host immich.home
        transport http {
            tls_insecure_skip_verify
        }
    }
}

# -- Carousel ---------------------------------------------------------------------

carousel.home {
    tls internal
    reverse_proxy https://100.x.x.x {
        header_up Host carousel.home
        transport http {
            tls_insecure_skip_verify
            tls_server_name carousel.home
            versions 1.1
        }
    }
}
