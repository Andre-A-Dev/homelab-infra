# Secrets – never commit these
**/.env
caddy.env
**/secrets/
**/*.key
**/*.pem
**/app.ini
shared/webhook/hooks.json

[includeIf "gitdir:~/Projects/github/"]
    path = ~/.config/git/github.inc

# Mail credentials
**/msmtprc

# Nextcloud data
**/html/data/

# Runtime junk
**/__pycache__/
**/*.pyc
.DS_Store
node_modules/

# JetBrains IDEs (PyCharm, IntelliJ, etc.)
.idea/
*.iml
desktop.ini
*.code-workspace
.directory
/.venv/

# CachyOS

# OpenRGB — never commit plugin binaries, only settings.
# Lesson from 2026-08-14: manually downloaded .so files caused the crash.
astraeus_nx/dotfiles/openrgb/**/*.so

# OpenRGB writes ~70+ log files, pure noise, never useful to version
astraeus_nx/dotfiles/openrgb/logs/

astraeus_nx/dotfiles/coolercontrol/*.cache
icons/*
