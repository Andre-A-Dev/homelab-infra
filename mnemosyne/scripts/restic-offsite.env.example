# =============================================================================
# restic-offsite.env  —  copy to /etc/restic/restic-offsite.env, chmod 600
# =============================================================================
# Loaded by both restic-offsite.sh and restic-maintenance.sh (systemd
# EnvironmentFile). Contains NO secrets directly — the repo password lives in
# a separate file referenced by RESTIC_PASSWORD_FILE. This file only needs 600
# because RESTIC_REPOSITORY reveals the offsite location.
# =============================================================================

# --- Repository location --------------------------------------------------
# SFTP backend against the Hetzner Storage Box. The repo is a subdirectory
# ("restic-repo") that will be created by `restic init` (see setup notes).
RESTIC_REPOSITORY=sftp:username@username.your-storagebox.de:restic-repo

# --- Repository password --------------------------------------------------
# The single point of failure. No password = no restore, ever. This file must
# be backed up OUTSIDE this system (Vaultwarden + one offline copy) BEFORE the
# first backup runs. Store it root-only: chmod 600.
RESTIC_PASSWORD_FILE=/root/.config/restic/password

# --- Explicit SSH command -------------------------------------------------
# Root's cron context does NOT read /home/youruser/.ssh/config, so the
# "hetzner-storagebox" alias is invisible here — the same trap that broke the
# rclone offsite step. We therefore spell out the key path, port and host
# explicitly instead of relying on any ssh config alias.
#
# The trailing "-s sftp" tells ssh to invoke the SFTP subsystem, which is what
# restic's sftp backend speaks.
RESTIC_SFTP_COMMAND="ssh -i /home/youruser/.ssh/hetzner_storagebox -p 23 username@username.your-storagebox.de -s sftp"

# --- Backup source --------------------------------------------------------
# restic backs up the local tarball tree produced by backup-services.sh, NOT
# the live service data. The tarballs are already application-consistent
# (maintenance mode, DB dumps), so restic inherits that consistency for free.
# restic skips unchanged dated directories by mtime and only re-reads the
# newest day's tarballs — deduplication then collapses the near-identical
# nextcloud-data.tar across days to near-zero upload.
RESTIC_BACKUP_SOURCE=/mnt/backup

# --- Retention policy (applied by `restic forget`) ------------------------
# Snapshot-level retention, independent of the local SSD's file retention.
# Because restic deduplicates, keeping 6 monthly snapshots costs almost nothing
# extra over keeping 7 daily ones — identical blocks are shared.
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6

# --- Metrics output -------------------------------------------------------
# Node Exporter textfile collector directory (same one backup-services.sh
# and the Viessmann exporter write to).
RESTIC_METRICS_DIR=/var/lib/node_exporter/textfile_collector

# --- restic cache ---------------------------------------------------------
# restic caches the repository index locally so it doesn't re-download it every
# run — essential for incremental speed. Pinned to an explicit path because the
# systemd hardening (ProtectHome=read-only) blocks the default /root/.cache.
# This directory is opened as a ReadWritePath in both service units.
RESTIC_CACHE_DIR=/var/cache/restic
