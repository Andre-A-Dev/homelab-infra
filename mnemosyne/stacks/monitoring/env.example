# -- Grafana -----------------------------------------------------------------------

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your-grafana-password
GF_SERVER_DOMAIN=grafana.home
GF_SERVER_ROOT_URL=https://grafana.home

# -- Nextcloud ---------------------------------------------------------------------

NEXTCLOUD_USERNAME=your-nextcloud-user
NEXTCLOUD_PASSWORD=your-nextcloud-app-password
NEXTCLOUD_SERVER=https://cloud.yourdomain.dedyn.io

# -- Netatmo -----------------------------------------------------------------------

NETATMO_CLIENT_ID=your-client-id
NETATMO_CLIENT_SECRET=your-client-secret

# -- Fritz!Box ---------------------------------------------------------------------

FRITZ_HOSTNAME=fritz.box
FRITZ_USERNAME=your-username
FRITZ_PASSWORD=your-password
FRITZ_LISTEN_ADDRESS=0.0.0.0

# -- Tado --------------------------------------------------------------------------

TADO_TOKEN_PASSPHRASE=your-passphrase

# -- Pi-hole (legacy keys removed — exporter config moved to prometheus.yml) -------

# -- Meross ------------------------------------------------------------------------

MEROSS_API_URL=https://iotx-eu.meross.com
MEROSS_EMAIL_1=your-email@example.com
MEROSS_PASSWORD_1=your-meross-password
MEROSS_ALIAS_1=your-device-alias
MEROSS_EMAIL_2=your-email@example.com
MEROSS_PASSWORD_2=your-meross-password
MEROSS_ALIAS_2=your-device-alias
MEROSS_DEVICE_NAMES=device1,device2

# -- Shelly ------------------------------------------------------------------------

SHELLY_DEVICES=192.168.178.XX,192.168.178.XX
POLL_INTERVAL=15
POLL_INTERVAL_SHELLY=15
RECONNECT_INTERVAL=30
EXPORTER_PORT=9100

# -- ntfy (Alertmanager notifications) --------------------------------------------

NTFY_PUMP_CRITICAL=Pump-Critical-yourtoken
NTFY_PUMP_WARNING=Pump-Warning-yourtoken
NTFY_MNEMOSYNE_CRITICAL=Mnemosyne-Critical-yourtoken
NTFY_MNEMOSYNE_WARNING=Mnemosyne-Warning-yourtoken

# -- MIDEA ------------------------------------------------------------------------

MIDEA_ACCOUNT_EMAIL=your-email@example.com
MIDEA_ACCOUNT_PASSWORD=your-password

# -- Prusa ------------------------------------------------------------------------

# Printer IP or host. Append :PORT only for a non-default PrusaLink port.
PRUSA_HOST=192.168.178.xx

# Authentication — provide ONE of the two below.
# Both are found on the printer: Settings -> Network -> PrusaLink.
# Test which one your firmware accepts before deploying:
#   curl -s -H "X-Api-Key: $KEY"        http://$PRUSA_HOST/api/v1/status | jq
#   curl -s --digest -u maker:$PASSWORD http://$PRUSA_HOST/api/v1/status | jq
#
# Option A (preferred if present): API key -> sent as X-Api-Key header.
PRUSA_API_KEY=1234
# Option B: password -> HTTP Digest auth with username `maker`.
PRUSA_PASSWORD=your-password

# Optional (defaults shown)
# -------------------------
# Digest-auth username (hardcoded to `maker` on current firmware).
PRUSA_USERNAME=maker
# Value for the `printer` label on every metric.
PRINTER_NAME=pygmalion
# Port the exporter serves /metrics on.
EXPORTER_PORT=9118
# HTTP timeout in seconds for each PrusaLink request.
SCRAPE_TIMEOUT=5
