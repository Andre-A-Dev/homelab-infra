# GhostProxy — Ghost Admin API bridge
# Copy to .env and fill in. Values are secrets; never commit the real .env.
GHOST_API_KEY=<admin-api-key-from-ghost-integrations>
GHOST_DB_PASSWORD=<must-match-ghost-stack-GHOST_DB_PASSWORD>
GHOST_URL=https://blog.yourdomain.dedyn.io
PROXY_EMAIL_DOMAIN=<domain-for-generated-sender-addresses>
UPLOAD_MAX_MB=5
