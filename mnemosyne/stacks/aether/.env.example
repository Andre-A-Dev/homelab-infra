# Aether configuration
# Copy to .env only if you need to override defaults; the compose file already
# sets sensible values. .env is gitignored.

# Where to reach the Prometheus HTTP API (default points at the monitoring network).
# PROMETHEUS_URL=http://prometheus:9090

# Port the console listens on inside the container (Caddy proxies to this).
# AETHER_PORT=8050

# Per-query timeout against Prometheus, in seconds.
# AETHER_QUERY_TIMEOUT=8
