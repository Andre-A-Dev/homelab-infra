# ============================================================
# SSH Client Configuration - CachyOS
# Managed in: ~/homelab-infra/shared/dotfiles/ssh_config
# ============================================================

# -- Global Defaults -----------------------------------------
Host *
ServerAliveInterval 60
ServerAliveCountMax 3
AddKeysToAgent yes
IdentitiesOnly yes

# -- Local Network --------------------------------------------
Host mnemosyne
    HostName 192.168.1.10
    User youruser
    IdentityFile ~/.ssh/id_ed25519_homelab

Host boreas
    HostName 192.168.1.11
    User youruser
    IdentityFile ~/.ssh/id_ed25519_homelab

Host hephaestus
    HostName 192.168.1.13
    User youruser
    IdentityFile ~/.ssh/id_ed25519_homelab

Host daidalos
    HostName 192.168.1.x
    User youruser
    IdentityFile ~/.ssh/id_ed25519_homelab

# -- Gitea (SSH Git, non-standard port) -----------------------
Host git.home
    HostName 192.168.1.10
    User git
    Port 2222
    IdentityFile ~/.ssh/id_ed25519_gitea

# -- GitHub (public mirror) ------------------------------------
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_github

# -- Tailscale ------------------------------------------------
Host mnemosyne-ts
    HostName mnemosyne.tail1234.ts.net
    User youruser
    IdentityFile ~/.ssh/id_ed25519_homelab

Host boreas-ts
    HostName boreas.tail1234.ts.net
    User youruser
    IdentityFile ~/.ssh/id_ed25519_homelab

Host hephaestus-ts
    HostName 100.x.x.x
    User youruser
    IdentityFile ~/.ssh/id_ed25519_homelab

Host daidalos-ts
    HostName 100.x.x.x
    User youruser
    IdentityFile ~/.ssh/id_ed25519_homelab

Host zephyros
    HostName 100.y.y.y
    User youruser
    IdentityFile ~/.ssh/id_ed25519_homelab
